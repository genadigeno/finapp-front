{
  "name": "finapp-front-end",
  "private": true,
  "version": "0.0.0",
  "description": "FinApp Customer Application - a single-page application over the finapp customer surface (ADR-F01).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:catalogue": "playwright test -c playwright.catalogue.config.ts",
    "theme:generate": "node scripts/theme-generate.mjs",
    "check:pins": "node scripts/check-pins.mjs",
    "check:licences": "node scripts/check-licences.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:reproducible": "node scripts/check-reproducible.mjs",
    "check:contract": "node scripts/check-contract.mjs",
    "contract:pull": "node scripts/contract-pull.mjs",
    "contract:generate": "node scripts/contract-generate.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx --omit dev > sbom.cdx.json",
    "verify": "npm run check:pins && npm run check:licences && npm run check:contract && npm run typecheck && npm run lint && npm run format:check && npm test && npm run build && npm run check:bundle"
  },
  "dependencies": {
    "@mantine/core": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@tabler/icons-react": "3.51.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-intl": "12.1.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
